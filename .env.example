# ComfyUI / DGX Spark 远程后端。不设 COMFY_SSH_PASSWORD 时所有 /api/comfyui/* 直接拒绝，
# 公网部署（如魔搭创空间）保持为空即可关闭该能力。
COMFY_SSH_PASSWORD=
COMFY_SSH_HOST=
COMFY_SSH_PORT=6078
COMFY_SSH_USER=Developer
COMFY_SSH_COMFY_PORT=8188

# 服务监听地址与端口。本地默认 127.0.0.1:3006；魔搭创空间要求 0.0.0.0:7860（端口不可改，8080 被平台占用）。
HOST=127.0.0.1
PORT=3006

# 生成素材与创作历史的落盘目录，默认在仓库内的 media/ 和 data/memory/。
# 魔搭创空间容器文件系统重启即丢失，需指向持久化卷 /mnt/workspace。
MEDIA_DIR=
MEMORY_DIR=

# 指定后 ffmpeg-static 不再下载二进制，直接使用该系统路径（Docker 镜像内为 apt 安装的 ffmpeg）。
FFMPEG_BIN=

# Persistent task store. Set TASK_STORE_DIR to enable file-backed task persistence;
# leave unset for in-memory only (tasks lost on restart).
TASK_STORE_DIR=
TASK_MAX_CONCURRENCY=4
TASK_PER_OWNER_LIMIT=2
TASK_RETENTION_HOURS=1

# H3 默认推理档位：fast / balanced / quality。客户端显式设置仍优先。
CINE_INFERENCE_PROFILE=balanced

# Visual compliance. OCR uses a local Tesseract CLI and never reports PASS when unavailable.
# Install tesseract-ocr plus eng/chi_sim language data, or point OCR_BIN to the executable.
OCR_BIN=tesseract
OCR_LANG=eng+chi_sim

# Optional JSON visual model endpoints. Each receives imageBase64/mimeType/metadata and
# returns {modelVersion, findings:[{label,confidence,action,evidence}]}. When empty,
# visual similarity/public-figure checks are marked UNAVAILABLE and require human review.
VISUAL_SIMILARITY_ENDPOINT=
PUBLIC_FIGURE_ENDPOINT=
VISUAL_COMPLIANCE_API_KEY=
